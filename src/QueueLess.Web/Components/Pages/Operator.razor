@page "/operator"
@attribute [Authorize(Roles = "Operator")]
@inherits LivePage
<PageTitle>Operator desk | QueueLess</PageTitle>
<div class="page-heading"><div><span class="eyebrow">KEEP CAMPUS MOVING</span><h1>Operator desk<span class="green-text">.</span></h1><p>A clear view of who's next and what needs your attention.</p></div><a class="button secondary" href="/display">Open live display <span aria-hidden="true">↗</span></a></div>
<Notice Result="Notice" />
<div class="operator-controls"><div><label for="operator-service">Your service desk</label><select id="operator-service" @bind="ServiceId" @bind:after="LoadAsync">@foreach (var service in Services) { <option value="@service.Service.Id">@service.Service.Name · Counter @service.Service.Counter.ToString("D2")</option> }</select></div><button class="button secondary" disabled="@Busy" @onclick="Toggle">@(Selected?.Service.IsOpen == true ? "Pause new arrivals" : "Reopen service")</button><button class="button primary" disabled="@(Busy || Current is not null || Selected?.Service.IsOpen != true)" @onclick="() => RunAsync(() => Queues.CallNextAsync(User, ServiceId))">Call next visitor <span aria-hidden="true">→</span></button></div>
<div class="operator-grid"><section class="panel now-serving"><span class="eyebrow">NOW SERVING · COUNTER @Selected?.Service.Counter.ToString("D2")</span><div class="big-ticket-code">@(Current?.Code ?? "—")</div><h2>@(Current?.Name ?? "Ready for the next visit")</h2><p>@(Current is null ? "Call the next visitor when you're ready." : "Help this visitor, then complete the visit to free the counter.")</p>@if (Current is not null) { <div class="action-row"><button class="button light" disabled="@Busy" @onclick="() => Finish(TicketStatus.Completed)"><Icon Name="check" Size="16" /> Complete visit</button>@if (ConfirmNoShow) { <button class="button danger" disabled="@Busy" @onclick="() => Finish(TicketStatus.NoShow)">Confirm no-show</button><button class="button secondary" @onclick="() => ConfirmNoShow = false">Keep serving</button> } else { <button class="button secondary" @onclick="() => ConfirmNoShow = true">Mark no-show</button> }</div> }</section><section class="panel"><div class="section-heading"><h2>Up next</h2><span class="count-label">@Waiting.Count waiting shown</span></div>@foreach (var ticket in Waiting) { <div class="queue-row"><span class="position">@((Waiting.IndexOf(ticket) + 1).ToString("D2"))</span><span class="mono">@ticket.Code</span><span class="visitor-name">@ticket.Name</span><span class="queued-time">@QueueRules.CampusTime(ticket.JoinedAt).ToString("HH:mm")</span></div> }@if (Waiting.Count == 0) { <div class="empty-state"><Icon Name="check" Size="32" /><h3>All caught up.</h3><p>New visitors will appear here automatically.</p></div> }<p class="estimate-note">First come, first served. Showing up to 100 active tickets.</p></section></div>
<div class="summary-strip"><div>Completed today<strong>@Snapshot.Completed</strong></div><div>Cancelled today<strong>@Snapshot.Cancelled</strong></div><div>No-shows today<strong>@Snapshot.NoShows</strong></div><div>Estimated service time<strong>@Selected?.Service.AverageMinutes min</strong></div></div>
<section class="panel audit-list"><div class="section-heading"><h2>Recent centre activity</h2><span class="count-label">Latest 8 actions</span></div>@foreach (var entry in Snapshot.Audit) { <p>@entry.Action<small>@QueueRules.CampusTime(entry.At).ToString("dd MMM, HH:mm:ss") · Account @entry.ActorId</small></p> }@if (Snapshot.Audit.Count == 0) { <p class="muted">Actions will be recorded here as visitors use the centre.</p> }</section>
@code {
    private int ServiceId = 1;
    private bool ConfirmNoShow;
    private List<ServiceSummary> Services = [];
    private OperatorSnapshot Snapshot = new([], 0, 0, 0, []);
    private ServiceSummary? Selected => Services.FirstOrDefault(s => s.Service.Id == ServiceId);
    private OperatorTicket? Current => Snapshot.Tickets.FirstOrDefault(t => t.Status == TicketStatus.Serving);
    private List<OperatorTicket> Waiting => Snapshot.Tickets.Where(t => t.Status == TicketStatus.Waiting).ToList();
    protected override async Task LoadAsync() { Services = await Queues.GetServicesAsync(); Snapshot = await Queues.GetOperatorSnapshotAsync(User, ServiceId); }
    private async Task Toggle() { if (Selected is not null) await RunAsync(() => Queues.SetServiceOpenAsync(User, ServiceId, !Selected.Service.IsOpen)); }
    private async Task Finish(TicketStatus status) { if (Current is not null) await RunAsync(() => Queues.FinishAsync(User, Current.Id, status)); ConfirmNoShow = false; }
}

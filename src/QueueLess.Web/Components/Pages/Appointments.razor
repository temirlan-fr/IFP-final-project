@page "/appointments"
@attribute [Authorize]
@inherits LivePage
<PageTitle>Appointments | QueueLess</PageTitle>
<div class="page-heading"><div><span class="eyebrow">A LITTLE PLANNING GOES A LONG WAY</span><h1>Make time for your visit<span class="green-text">.</span></h1><p>Choose an arrival slot. We'll have your visit on the calendar.</p></div><span class="live-pill"><Icon Name="clock" Size="16" /> Campus time · UTC+5</span></div>
<Notice Result="Notice" />
<div class="booking-layout"><section class="panel booking-form"><span class="eyebrow">BOOK A VISIT</span><h2>When works for you?</h2><label for="service">Choose a service</label><select id="service" @bind="ServiceId" @bind:after="SelectionChanged">@foreach (var service in Services) { <option value="@service.Service.Id">@service.Service.Name @(service.Service.IsOpen ? "" : "(paused)")</option> }</select><label for="visit-date">Choose a date</label><input type="date" id="visit-date" @bind="Date" @bind:after="SelectionChanged" min="@Today.ToString("yyyy-MM-dd")" max="@Today.AddDays(7).ToString("yyyy-MM-dd")" /><div class="section-heading slot-heading"><h3>Available arrival times</h3><span class="count-label">30 minute slots</span></div><div class="slot-grid">@foreach (var slot in Slots) { <button aria-pressed="@(SelectedSlot == slot)" class="slot @(SelectedSlot == slot ? "selected" : "")" @onclick="() => SelectedSlot = slot">@QueueRules.CampusTime(slot).ToString("HH:mm")</button> }</div>@if (Slots.Count == 0) { <p class="muted">No times are available on this date. Try another day or service.</p> }<p class="booking-note">This reserves an arrival window, not an exact service start. Check in to join the live queue in arrival order. You can hold up to three upcoming visits.</p><button class="button primary full" disabled="@(SelectedSlot == 0 || Busy)" @onclick="Book">Confirm appointment <span aria-hidden="true">→</span></button></section>
<section class="appointment-list"><div class="section-heading"><div><h2>Your appointments</h2><p>Check in, reschedule by cancelling, or review recent visits.</p></div></div>@if (Bookings.Count == 0) { <div class="panel empty-state"><Icon Name="calendar" Size="38" /><h2>Room for something new.</h2><p>Your booked visits will appear here.</p></div> }@foreach (var booking in Bookings) { <article class="panel appointment-card"><div class="appointment-date"><strong>@QueueRules.CampusTime(booking.StartsAt).ToString("dd")</strong><span>@QueueRules.CampusTime(booking.StartsAt).ToString("MMM")</span></div><div class="appointment-details"><h3>@booking.Service.Name</h3><p>@QueueRules.CampusTime(booking.StartsAt).ToString("dddd, HH:mm") · Counter @booking.Service.Counter.ToString("D2")</p><span class="status-badge">@booking.Status</span>@if (booking.Status == BookingStatus.Reserved) { <div class="appointment-actions"><button class="button primary small" disabled="@(Busy || !QueueRules.CanCheckIn(booking.StartsAt, DateTimeOffset.UtcNow.ToUnixTimeSeconds()))" @onclick="() => RunAsync(() => Queues.CheckInAsync(User, booking.Id))">Check in</button>@if (CancelId == booking.Id) { <button class="button danger small" disabled="@Busy" @onclick="() => Cancel(booking.Id)">Confirm cancellation</button><button class="text-button" @onclick="() => CancelId = 0">Keep visit</button> } else { <button class="text-button" @onclick="() => CancelId = booking.Id">Cancel visit</button> }</div><small class="muted">Check-in: 10 minutes before to 15 minutes after.</small> }</div></article> }</section></div>
@code {
    private List<ServiceSummary> Services = [];
    private List<Appointment> Bookings = [];
    private List<long> Slots = [];
    private int ServiceId = 1, CancelId;
    private long SelectedSlot;
    private static DateOnly Today => DateOnly.FromDateTime(QueueRules.CampusTime(DateTimeOffset.UtcNow.ToUnixTimeSeconds()).DateTime);
    private DateOnly Date = Today;
    protected override async Task LoadAsync() { Services = await Queues.GetServicesAsync(); Bookings = await Queues.GetAppointmentsAsync(User); Slots = await Queues.GetAvailableSlotsAsync(ServiceId, Date); if (!Slots.Contains(SelectedSlot)) SelectedSlot = 0; }
    private async Task SelectionChanged() { SelectedSlot = 0; Slots = await Queues.GetAvailableSlotsAsync(ServiceId, Date); }
    private async Task Book() { await RunAsync(() => Queues.BookAsync(User, ServiceId, SelectedSlot)); SelectedSlot = 0; }
    private async Task Cancel(int id) { await RunAsync(() => Queues.CancelBookingAsync(User, id)); CancelId = 0; }
}

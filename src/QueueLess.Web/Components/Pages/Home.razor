@page "/"
@inherits LivePage
<PageTitle>Overview | QueueLess</PageTitle>
<div class="page-heading"><div><span class="eyebrow">A LITTLE LESS WAITING</span><h1>Your day, without the delay<span class="green-text">.</span></h1><p>Find your service, save your spot and get on with your day.</p></div><a class="button secondary" href="/appointments"><Icon Name="calendar" Size="18" /> Book a visit</a></div>
<Notice Result="Notice" />
<section class="hero-banner"><div class="hero-copy"><span class="hero-label"><span class="online-dot"></span> SMARTER CAMPUS VISITS</span><h2>Stay in the loop.<br />Not in the line.</h2><p>Your next campus visit starts here.<br />Join a live queue or pick a time that works for you.</p><a href="#services" class="button light">Explore services <span aria-hidden="true">↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="floating-label"><span class="online-dot"></span> Time well saved</div><div class="illustrated-ticket"><div class="mini-brand">q. <span>QueueLess</span></div><div class="ticket-dashes"></div><small>YOUR TIME MATTERS</small><strong>You're next.</strong><div class="ticket-art-bottom"><span>LESS WAITING</span><Icon Name="check" Size="24" /></div></div><div class="tiny-clock"><Icon Name="clock" Size="28" /></div></div></section>
<section class="stat-grid" aria-label="Live queue summary"><div class="stat-card"><span class="stat-icon pale-green"><Icon Name="grid" /></span><div><span>Services available</span><strong>@Services.Count(s => s.Service.IsOpen)<small> / @Services.Count</small></strong></div></div><div class="stat-card"><span class="stat-icon pale-purple"><Icon Name="users" /></span><div><span>People waiting</span><strong>@Services.Sum(s => s.Waiting)<small> across campus</small></strong></div></div><div class="stat-card"><span class="stat-icon pale-orange"><Icon Name="clock" /></span><div><span>Shortest estimated wait</span><strong>@(Services.Where(s => s.Service.IsOpen).Select(s => (int?)s.EstimatedMinutes).Min()?.ToString() ?? "—")<small> min</small></strong></div></div></section>
<div class="dashboard-columns"><section id="services"><div class="section-heading"><div><h2>What brings you here?</h2><p>Choose a service to join the queue.</p></div><span class="count-label">@Filtered.Count() services</span></div><div class="filter-bar"><div class="filter-tabs" role="group" aria-label="Service category">@foreach (var category in new[] { "All services", "Academic", "Technology", "Finance", "Library" }) { <button class="@(Category == category ? "selected" : "")" @onclick="() => Category = category">@category</button> }</div><label class="search-field"><Icon Name="search" Size="17" /><input aria-label="Search services" placeholder="Search" @bind="Search" @bind:event="oninput" /></label></div><div class="service-grid">@foreach (var service in Filtered) { <ServiceCard Summary="service" Disabled="Busy" OnJoin="Join" /> }@if (!Filtered.Any()) { <div class="empty-state"><h3>No services found</h3><p>Try another name or category.</p><button class="button secondary" @onclick="ClearFilters">Clear filters</button></div> }</div><p class="estimate-note"><Icon Name="clock" Size="14" /> Wait times are estimates and may change as visits take longer or finish early.</p></section>
<aside class="right-column"><section class="panel your-visit"><div class="section-heading"><h2>Your next stop</h2><Icon Name="ticket" /></div>@if (ActiveTicket is not null) { <StatusBadge Status="ActiveTicket.Status" /><div class="active-ticket-code">@ActiveTicket.Code</div><h3>@ActiveTicket.Service</h3><p>@(ActiveTicket.Status == TicketStatus.Serving ? $"It's your turn. Go to counter {ActiveTicket.Counter:D2}." : $"{ActiveTicket.Ahead} waiting ahead · About {ActiveTicket.WaitMinutes} min")</p><a class="button primary full" href="/tickets">View my ticket <span aria-hidden="true">→</span></a> } else { <div class="empty-ticket-icon"><Icon Name="ticket" Size="34" /></div><h3>No waiting on your agenda.</h3><p>Join a queue and your live ticket will appear right here.</p><span class="quiet-label">A little more time for you.</span> }</section><section class="how-card"><span class="eyebrow">IT'S AS EASY AS</span><h3>Your visit, simplified.</h3><div><span>01</span><p><strong>Choose your service</strong><small>Find the right desk for your visit.</small></p></div><div><span>02</span><p><strong>Save your place</strong><small>Join now or book ahead.</small></p></div><div><span>03</span><p><strong>Arrive when it's time</strong><small>Follow your ticket for live updates.</small></p></div></section></aside></div>
@code {
    private List<ServiceSummary> Services = [];
    private TicketView? ActiveTicket;
    private string Category = "All services", Search = "";
    private IEnumerable<ServiceSummary> Filtered => Services.Where(s => (Category == "All services" || s.Service.Category == Category) && (s.Service.Name.Contains(Search, StringComparison.OrdinalIgnoreCase) || s.Service.Description.Contains(Search, StringComparison.OrdinalIgnoreCase)));
    protected override async Task LoadAsync() { Services = await Queues.GetServicesAsync(); if (User.Identity?.IsAuthenticated == true) ActiveTicket = (await Queues.GetMyTicketsAsync(User)).FirstOrDefault(t => QueueRules.IsActive(t.Status)); }
    private async Task Join(int id) { if (User.Identity?.IsAuthenticated != true) { Navigation.NavigateTo("/login", true); return; } await RunAsync(() => Queues.JoinAsync(User, id)); }
    private void ClearFilters() { Category = "All services"; Search = ""; }
}
